generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  phoneNumber           String                 @unique
  email                 String?                @unique
  password              String?
  firstName             String?
  lastName              String?
  isProfileComplete     Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  @@map("users")
}

