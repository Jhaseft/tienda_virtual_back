generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OtpCode {
  id        String   @id @default(uuid())
  target    String
  code      String
  type      OtpType
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

enum OtpType {
  EMAIL
  WHATSAPP
}

model Plan {
  id                   String   @id @default(uuid())
  name                 String   @unique
  price                Float
  maxProducts          Int
  description          String?
  canAddPaymentMethods Boolean  @default(false)
  hasAiAgent           Boolean  @default(false)
  hasAdvancedPayments  Boolean  @default(false)
  hasChat              Boolean  @default(false)
  priceOferta          Float?
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id          String             @id @default(uuid())
  storeId     String             @unique
  planId      String
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime           @default(now())
  endDate     DateTime
  trialEndsAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  store    Store                 @relation(fields: [storeId], references: [id])
  plan     Plan                  @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@map("subscriptions")
}

model SubscriptionPayment {
  id                    String         @id @default(uuid())
  subscriptionId        String
  amount                Float
  paymentChannel        PaymentChannel
  stripePaymentIntentId String?
  stripePaymentMethodId String?
  planId                String?
  banecoQrId            String?
  qrExpiresAt           DateTime?
  status                PaymentStatus  @default(PENDING)
  createdAt             DateTime       @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_payments")
}

enum PaymentChannel {
  QR_BANCO
  STRIPE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

model User {
  id                   String   @id @default(uuid())
  phoneNumber          String?  @unique
  email                String?  @unique
  googleId             String?  @unique
  password             String?
  firstName            String?
  lastName             String?
  avatarUrl            String?
  avatarPublicId       String?
  role                 UserRole @default(CLIENT)
  isProfileComplete    Boolean  @default(false)
  notificationsEnabled Boolean  @default(true)
  stripeCustomerId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  store          Store?
  orders         Order[]
  favorites      Favorite[]
  addresses      Address[]
  cartItems      CartItem[]
  paymentMethods UserPaymentMethod[]
  reviews        Review[]
  following      StoreFollower[]
  conversations  Conversation[]

  @@map("users")
}

enum UserRole {
  CLIENT
  VENDOR
  ADMIN
}

model Store {
  id              String   @id @default(uuid())
  ownerId         String   @unique
  subdomain       String?  @unique
  name            String
  storeType       String?
  description     String?
  logoUrl         String?
  logoPublicId    String?
  qrImageUrl      String?
  qrImagePublicId String?
  address         String?
  city            String?
  whatsapp        String?
  trialEndsAt     DateTime?
  isOpen          Boolean  @default(true)
  rating          Float    @default(0)
  totalReviews    Int      @default(0)
  totalSales      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner          User                 @relation(fields: [ownerId], references: [id])
  subscription   Subscription?
  products       Product[]
  orders         Order[]
  favorites      Favorite[]
  followers      StoreFollower[]
  paymentMethods StorePaymentMethod[]
  reviews        Review[]
  socialLinks    StoreSocialLink[]
  shippingZones  ShippingZone[]
  cartItems      CartItem[]
  conversations  Conversation[]

  @@map("stores")
}

model ShippingZone {
  id            String        @id @default(uuid())
  storeId       String
  city          String
  transportType TransportType
  shippingCost  Float
  minHours      Int
  maxHours      Int
  isActive      Boolean       @default(true)

  store  Store   @relation(fields: [storeId], references: [id])
  orders Order[]

  @@unique([storeId, city, transportType])
  @@map("shipping_zones")
}

enum TransportType {
  BUS
  AVION
  MOTO
  A_PIE
  PROPIO
  EXPRESS
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  productId String
  quantity  Int      @default(1)
  variant   String?
  colorName String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

model StoreSocialLink {
  id      String        @id @default(uuid())
  storeId String
  network SocialNetwork
  url     String

  store Store @relation(fields: [storeId], references: [id])

  @@map("store_social_links")
}

model StoreFollower {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
  @@map("store_followers")
}

model StorePaymentMethod {
  id              String      @id @default(uuid())
  storeId         String
  type            PaymentType
  bankName        String?
  accountHolder   String?
  accountNumber   String?
  phoneNumber     String?
  qrImageUrl      String?
  qrImagePublicId String?

  store Store @relation(fields: [storeId], references: [id])

  @@map("store_payment_methods")
}

enum PaymentType {
  QR
  YAPE
  TIGO_MONEY
  EFECTIVO
  TRANSFERENCIA
  WHATSAPP
}

enum SocialNetwork {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITTER
  WHATSAPP
  WEBSITE
}

model Category {
  id           String    @id @default(uuid())
  name         String    @unique
  iconUrl      String?
  iconPublicId String?
  products     Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  storeId     String
  categoryId  String?
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  isAvailable Boolean  @default(true)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store      Store          @relation(fields: [storeId], references: [id])
  category   Category?      @relation(fields: [categoryId], references: [id])
  photos     ProductPhoto[]
  sizes      ProductSize[]
  colors     ProductColor[]
  orderItems OrderItem[]
  favorites  Favorite[]
  cartItems  CartItem[]

  @@map("products")
}

model ProductPhoto {
  id        String @id @default(uuid())
  productId String
  url       String
  publicId  String
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@map("product_photos")
}

model ProductSize {
  id        String @id @default(uuid())
  productId String
  size      String
  stock     Int    @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@map("product_sizes")
}

model ProductColor {
  id        String  @id @default(uuid())
  productId String
  name      String
  hexCode   String?
  stock     Int     @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@map("product_colors")
}

model Order {
  id                String      @id @default(uuid())
  orderSeq          Int         @default(autoincrement())
  clientId          String
  storeId           String
  status            OrderStatus @default(PENDING)
  paymentMethod     PaymentType
  pickupMethod      PickupMethod?
  deliveryAddress   String?
  addressId         String?
  shippingZoneId    String?
  subtotal          Float
  shippingCost      Float       @default(0)
  total             Float
  voucherUrl        String?
  voucherPublicId   String?
  whatsappThreadUrl String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  client       User          @relation(fields: [clientId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  address      Address?      @relation(fields: [addressId], references: [id])
  shippingZone ShippingZone? @relation(fields: [shippingZoneId], references: [id])
  items        OrderItem[]
  review       Review?

  @@map("orders")
}

enum PickupMethod {
  WHATSAPP
  STORE_PICKUP
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  size      String?
  colorName String?
  quantity  Int
  unitPrice Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING // PENDIENTE
  CONFIRMED // CONFIRMADO
  PAID// PAGADO
  SHIPPED // ENVIADO
  DELIVERED // ENTREGADO
  CANCELLED // CANCELADO
}

model Review {
  id        String   @id @default(uuid())
  storeId   String
  clientId  String
  orderId   String?  @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  store  Store  @relation(fields: [storeId], references: [id])
  client User   @relation(fields: [clientId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@map("reviews")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String?
  storeId   String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  store   Store?   @relation(fields: [storeId], references: [id])

  @@unique([userId, productId])
  @@unique([userId, storeId])
  @@map("favorites")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  fullName  String?
  phone     String?
  label     String?
  street    String
  city      String
  state     String?
  zipCode   String?
  country   String   @default("Bolivia")
  reference String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@map("addresses")
}

model UserPaymentMethod {
  id        String      @id @default(uuid())
  userId    String
  type      PaymentType
  alias     String?
  details   String?
  isDefault Boolean     @default(false)

  user User @relation(fields: [userId], references: [id])

  @@map("user_payment_methods")
}

model SystemConfig {
  id               String   @id @default("1")
  trialDays        Int      @default(15)
  trialMaxProducts Int      @default(8)
  exchangeRateBob  Float    @default(6.90)
  updatedAt        DateTime @updatedAt

  @@map("system_config")
}

model Conversation {
  id        String    @id @default(uuid())
  clientId  String
  storeId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client    User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([clientId, storeId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  senderRole     MessageRole
  text           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MessageRole {
  CLIENT
  VENDOR
}
